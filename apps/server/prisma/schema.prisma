generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/macOS/whatever host runs `npm run dev`).
    // "debian-openssl-3.0.x" is explicit so a client generated on a developer
    // machine also contains the engine required by the Debian Docker runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artist {
  id               Int          @id @default(autoincrement())
  name             String
  sortName         String
  imvdbArtistId    String?      @unique
  musicbrainzArtistId String?   @unique
  musicbrainzMatchStatus String @default("unmatched") // unmatched | suggested | ambiguous | confirmed | linked | notFound | failed
  musicbrainzMatchConfidence Float?
  musicbrainzMatchEvidence String? // JSON describing the observations used for the match
  musicbrainzRefreshedAt DateTime?
  artistType       String?
  country          String?
  disambiguation   String?
  // Defaults to false: a newly discovered/imported artist shouldn't start
  // auto-downloading its whole catalog just from being added. Only the
  // DEFAULT changed here — existing rows keep whatever value they already
  // had (see migration 20260920041539_artist_unmonitored_by_default).
  monitored        Boolean      @default(false)
  rootFolderId     Int
  rootFolder       RootFolder   @relation(fields: [rootFolderId], references: [id])
  qualityProfileId Int
  qualityProfile   QualityProfile @relation(fields: [qualityProfileId], references: [id])
  posterUrl        String?
  genre            String? // user-editable; auto-fillable from a matched LibraryArtist (Jellyfin) or a "standard" external source (Spotify's controlled-vocabulary genres) — see pipeline/genreMatch.ts
  genreSource      String? // user | embedded | musicbrainz | connector | folksonomy
  // When ArtistGenre candidates were last fetched from MusicBrainz/Last.fm
  // (null = never; the backfill job works through these).
  genresRefreshedAt DateTime?
  genresRefreshAttemptedAt DateTime?
  metadataRefreshedAt DateTime?
  videoInventoryCheckedAt DateTime?
  videoInventoryAttemptedAt DateTime?
  videoInventoryCompletedAt DateTime?
  videoInventoryStatus String @default("pending") // pending | running | complete | partial | failed
  videoInventoryError String?
  reconciledAt     DateTime?
  addedAt          DateTime     @default(now())

  liveCredits LiveCredit[]
  liveRules LiveMonitoringRule[]
  livePerformances LivePerformance[]
  musicVideos   MusicVideo[]
  youtubeSources YoutubeSource[]
  sources       ArtistSource[]
  musicbrainzCandidates MusicBrainzArtistCandidate[]
  videoReviewCandidates VideoReviewCandidate[]
  genres        ArtistGenre[]
}

// Per-source genre candidates for an artist. Sources are kept side by side
// (never merged into one value) so the user can see where a genre came from and
// judge it; the genres actually in effect are derived from these rows by
// pipeline/artistGenres.ts and mirrored into Artist.genre for older consumers.
model ArtistGenre {
  id        Int      @id @default(autoincrement())
  artistId  Int
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name      String   // normalised (lowercase, MusicBrainz spelling where one exists)
  level     String   // genre | subgenre
  parent    String?  // broad genre a subgenre rolls up into
  source    String   // user | musicbrainz | lastfm | spotify | connector | embedded
  votes     Int?     // MusicBrainz vote count / Last.fm tag weight (0-100); null for user/connector
  createdAt DateTime @default(now())

  @@unique([artistId, name, source])
  @@index([name])
}

model MusicVideo {
  qualifiedPlayCount Int @default(0)
  lastQualifiedPlayAt DateTime?
  qualifiedPlaybacks QualifiedPlayback[]
  isLiveConcert  Boolean @default(false)
  deletionState  String?
  deletionError  String?
  deletionTargets String?
  deletionNextAttemptAt DateTime?
  deletionAttempts Int @default(0)
  id             Int      @id @default(autoincrement())
  artistId       Int
  artist         Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title          String
  normalizedTitle String
  imvdbVideoId   String?  @unique
  musicbrainzRecordingId String? @unique
  musicbrainzAudioRecordingId String?
  catalogKind    String   @default("official") // official | supplementary | inventory
  youtubeVideoId String?  @unique
  releaseYear    Int?
  sourcePublishedAt DateTime? // YouTube publication time, when known; distinct from the song video's release year
  director       String?
  durationSeconds Int?
  genre          String? // user-editable "song tag" — see Artist.genre
  monitored      Boolean  @default(true)
  // Independent of `monitored`: an explicit "don't act on this one" that
  // always blocks acquisition (even a deliberate manual grab), whereas
  // `monitored` only gates automatic backlog/upgrade search — see
  // pipeline/videoStatus.ts.
  ignored        Boolean  @default(false)
  hasFile        Boolean  @default(false)
  thumbnailUrl   String?
  catalogStatus  String   @default("active") // "active" | "removedReview"
  lastSeenAt     DateTime?
  removedAt      DateTime?
  awaitingServerScanAt DateTime?
  addedAt        DateTime @default(now())

  recordings     Recording[]
  file           MusicVideoFile?
  queueItems     DownloadQueueItem[]
  history        History[]
  playlistItems  PlaylistItem[]
  libraryVideos  LibraryVideo[] @relation("LibraryVideoMatch")
  rejectedByLibraryVideos LibraryVideo[] @relation("LibraryVideoRejectedMatch")
  acquisitionSources AcquisitionSource[]

  @@unique([artistId, normalizedTitle])
}

model ArtistSource {
  id          Int      @id @default(autoincrement())
  artistId    Int
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String?
  origin      String
  lastSeenAt  DateTime @default(now())

  @@unique([artistId, provider, origin])
}

model AcquisitionSource {
  recordingId Int?
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  id             Int        @id @default(autoincrement())
  musicVideoId   Int
  musicVideo     MusicVideo @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  provider       String
  externalId     String?
  url            String
  authority      String // "authoritative" | "verified" | "heuristic" | "manual"
  confidence     String // "confirmed" | "probable" | "review"
  discoveryOrigin String
  accepted       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([musicVideoId, provider, url])
  @@index([musicVideoId, authority, confidence])
}

model MusicVideoFile {
  id           Int        @id @default(autoincrement())
  musicVideoId Int        @unique
  musicVideo   MusicVideo @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  path         String
  qualityId    Int?
  quality      Quality?   @relation(fields: [qualityId], references: [id])
  sizeBytes    BigInt
  mediaInfo    String? // JSON blob: codec/resolution/bitrate
  originalFilename String
  dateAdded    DateTime   @default(now())
  playCount        Int?      // synced from a Plex/Jellyfin library connector's watch stats for the matched item — see pipeline/playCountSync.ts
  playCountSyncedAt DateTime?
  recordingPart RecordingPart?
}

model Quality {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  source     String // "web" | "youtube" | "unknown"
  resolution Int?
  weight     Int

  profileItems   QualityProfileItem[]
  files          MusicVideoFile[]
}

model QualityProfile {
  id              Int    @id @default(autoincrement())
  name            String @unique
  cutoffQualityId Int

  items   QualityProfileItem[]
  artists Artist[]
}

model QualityProfileItem {
  id               Int            @id @default(autoincrement())
  qualityProfileId Int
  qualityProfile   QualityProfile @relation(fields: [qualityProfileId], references: [id], onDelete: Cascade)
  qualityId        Int
  quality          Quality        @relation(fields: [qualityId], references: [id])
  allowed          Boolean        @default(true)

  @@unique([qualityProfileId, qualityId])
}

model RootFolder {
  recordingQueueItems DownloadQueueItem[]
  recordingParts RecordingPart[]
  id             Int      @id @default(autoincrement())
  path           String   @unique
  freeSpaceBytes BigInt?
  accessible     Boolean  @default(true)
  lastCheckedAt  DateTime?
  targetConnectorId Int?
  targetConnector LibraryConnector? @relation(fields: [targetConnectorId], references: [id], onDelete: SetNull)

  artists Artist[]
}

model Indexer {
  id             Int     @id @default(autoincrement())
  name           String
  implementation String // "Torznab" | "Newznab"
  baseUrl        String
  apiKey         String?
  categories     String // JSON-encoded int[]
  enabled        Boolean @default(true)
  priority       Int     @default(25)
}

model DownloadClient {
  id             Int     @id @default(autoincrement())
  name           String
  implementation String // "qBittorrent" | "SABnzbd"
  host           String
  port           Int
  username       String?
  password       String?
  apiKey         String?
  category       String?
  enabled        Boolean @default(true)
  priority       Int     @default(25)

  queueItems DownloadQueueItem[]
}

model YoutubeSource {
  id             Int       @id @default(autoincrement())
  type           String // "channel" | "playlist" | "single_video"
  url            String
  artistId       Int
  artist         Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  monitored      Boolean   @default(true)
  lastPolledAt   DateTime?
  qualitySelector String   @default("bestvideo[height<=1080]+bestaudio")
}

model DownloadQueueItem {
  id               Int             @id @default(autoincrement())
  musicVideoId     Int?
  musicVideo       MusicVideo?     @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  recordingId Int?
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  recordingSourceId Int?
  recordingSource RecordingSource? @relation(fields: [recordingSourceId], references: [id], onDelete: SetNull)
  selectedFiles String?
  validationPolicy String?
  rootFolderId Int?
  rootFolder RootFolder? @relation(fields: [rootFolderId], references: [id], onDelete: Restrict)
  partPosition Int @default(1)
  sourceType       String // "indexer" | "youtube"
  sourceRef        String
  downloadClientId Int?
  downloadClient   DownloadClient? @relation(fields: [downloadClientId], references: [id])
  status           String // "queued" | "downloading" | "submissionUnknown" | "importing" | "failed"
  progress         Float           @default(0)
  error            String?
  quality          String? // parsed at grab time; needed at import time since no file exists yet to read it from
  downloadedPath   String?
  stagingDirectory String?
  downloadedAt     DateTime?
  processingStartedAt DateTime?
  phase            String? // extracting/transferring/merging/waitingValidation/validating/importing; legacy preserves pre-pipeline staging
  stageTimings     String? // JSON numeric durations/rate; never source URLs or credentials
  addedAt          DateTime        @default(now())
  queuePosition    Int             @default(0) // negative positions precede new FIFO entries
  validationCategory String        @default("additional") // source classification, never a queued policy snapshot
  @@index([status, addedAt, id])
  @@index([status, queuePosition, addedAt, id])
}

model History {
  id           Int        @id @default(autoincrement())
  musicVideoId Int?
  musicVideo   MusicVideo? @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  recordingId Int?
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  eventType    String // "grabbed" | "downloadFolderImported" | "downloadFailed" | "deleted" | "renamed"
  date         DateTime   @default(now())
  data         String? // JSON blob
}

model ActivityLog {
  id      Int      @id @default(autoincrement())
  level   String // "info" | "warn" | "error"
  source  String
  message String
  date    DateTime @default(now())
}

model ScheduledTask {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  intervalMs   Int
  lastRunAt    DateTime?
  lastResult   String? // "success" | "failed"
  lastError    String?
}

model Settings {
  warnBeforeDelete Boolean @default(true)
  excludeDeletedVideosFromScans Boolean @default(false)
  validationSettings String @default("{\"policies\":{\"imports\":{\"file\":true,\"motion\":true},\"canonical\":{\"file\":false,\"motion\":false},\"additional\":{\"file\":true,\"motion\":true}},\"minimumDimension\":64,\"maximumStaticPercent\":80}")
  defaultPlaybackConnectorId Int? // validated enabled Plex/Jellyfin video connector; stale defaults are ignored
  id             Int     @id @default(1)
  namingFormat   String  @default("{Artist Name}/{Video Title} ({Year})/{Artist Name} - {Video Title} ({Year}) [{Quality}]")
  transferMode   String  @default("move") // "hardlink" | "copy" | "move"
  minFreeSpaceMb Int     @default(1024)
  maxConcurrentDownloads Int @default(3)
  imvdbApiKey    String?
  apiKey         String? // vidarr's own API key — required on every /api/v1/* request except /health. Generated on first boot (see pipeline/auth.ts); matches Sonarr/Radarr's own single-user API-key model.
  apiKeyGeneratedAt DateTime? // when the current apiKey was generated — bounds the /setup/bootstrap-key reveal window (see api/setup.ts)
  apiKeyFirstUsedAt DateTime? // set the first time apiKey successfully authenticates a request; once set, /setup/bootstrap-key permanently stops revealing it

  // Google Sign-On: an alternative, browser-only way to obtain the real
  // apiKey (see api/googleAuth.ts) — not a parallel auth system. Every
  // /api/v1/* request still authenticates with apiKey exactly as before;
  // this just gates *handing that key to a browser* behind "is this the one
  // allowed Google account" instead of "did you already have the key."
  googleClientId     String?
  googleClientSecret String?
  googleAllowedEmail String? // the single Google account allowed to sign in this way

  // Username/password login: another alternative, browser-only way to obtain
  // the real apiKey (see api/localAuth.ts and pipeline/password.ts) — same
  // relationship to apiKey as Google Sign-On above, not a parallel credential.
  // adminPasswordHash is never the plaintext password — only set via
  // POST /api/v1/auth/login/credentials, which hashes it server-side.
  adminUsername     String?
  adminPasswordHash String? // format "<hex salt>:<hex scrypt derived key>"
}

model DeletedVideoRecord {
  id Int @id @default(autoincrement())
  originalMusicVideoId Int @unique
  artistId Int
  title String
  identities String
  deletedAt DateTime @default(now())
  @@index([artistId])
}

model LibraryConnector {
  recordingCopies RecordingServerCopy[]
  id             Int       @id @default(autoincrement())
  name           String
  type           String // "plex" | "jellyfin" | "subsonic"
  host           String
  authToken      String? // Plex X-Plex-Token, or Jellyfin API key
  username       String? // Jellyfin / Subsonic
  password       String? // Subsonic only (salted-MD5 auth requires it server-side)
  userId         String? // Jellyfin user id resolved by Test; separate from the selected music library
  musicLibraryId String? // selected Plex/Jellyfin music section used to read artists (LibraryArtist sync)
  musicPath      String? // optional local/container path scanned read-only for embedded Picard tags
  videoLibraryId String? // section/library holding vidarr's own downloaded music videos — used for playlist push; a different library than musicLibraryId, picked by the user from listSections()
  enabled        Boolean   @default(true)
  lastSyncedAt   DateTime?
  lastSyncStatus String? // "success" | "failed"
  lastSyncError  String?
  syncRunning    Boolean    @default(false)
  syncProcessed  Int        @default(0)
  syncTotal      Int?

  libraryArtists    LibraryArtist[]
  libraryRecordings LibraryRecording[]
  libraryVideos     LibraryVideo[]
  playlistSyncs  PlaylistSync[]
  rootFolders    RootFolder[]
}

model LibraryRecording {
  id                        Int              @id @default(autoincrement())
  connectorId               Int
  connector                 LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  filePath                  String
  title                     String
  album                     String?
  artistName                String
  albumArtistName           String?
  genre                     String?
  trackNumber               Int?
  discNumber                Int?
  musicbrainzArtistId       String?
  musicbrainzAlbumArtistId  String?
  musicbrainzRecordingId    String?
  musicbrainzReleaseId      String?
  musicbrainzReleaseGroupId String?
  lastSyncedAt              DateTime         @default(now())

  @@unique([connectorId, filePath])
  @@index([musicbrainzArtistId])
  @@index([musicbrainzRecordingId])
}

// A video observed in a selected Plex/Jellyfin music-video library. This is
// deliberately separate from MusicVideoFile: availability in a media server
// does not prove Vidarr owns or can access the underlying local file.
model LibraryVideo {
  recordingId Int?
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  id                   Int              @id @default(autoincrement())
  connectorId          Int
  connector            LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  externalId           String
  title                String
  normalizedTitle      String
  artistName           String
  normalizedArtistName String
  releaseYear          Int?
  durationSeconds      Int?
  path                 String?
  playCount            Int?
  hasThumbnail         Boolean          @default(false)
  available            Boolean          @default(true)
  lastSyncedAt         DateTime         @default(now())
  musicVideoId         Int?
  musicVideo           MusicVideo?      @relation("LibraryVideoMatch", fields: [musicVideoId], references: [id], onDelete: SetNull)
  // Set (alongside matchConfidence) only for a fuzzy, non-exact match a sync
  // proposed — null for an exact-key match, which needs no review. See
  // pipeline/reconciliation.ts.
  matchConfidence      String?
  // A human-rejected candidate for this row, remembered so the next sync's
  // fuzzy fallback doesn't immediately re-propose the same wrong match —
  // confirmed via research that nothing previously remembered a past
  // reconciliation decision at all.
  rejectedMusicVideoId Int?
  rejectedMusicVideo   MusicVideo?      @relation("LibraryVideoRejectedMatch", fields: [rejectedMusicVideoId], references: [id], onDelete: SetNull)

  @@unique([connectorId, externalId])
  @@index([normalizedArtistName, normalizedTitle])
}

model Playlist {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  kind      String   @default("static") // static | smart
  ruleFilters String? // validated PlaylistFilters JSON for smart playlists
  ruleMatchMode String? // all | any
  regenerateIntervalMinutes Int? // null = manual only
  lastGeneratedAt DateTime?
  targetConnectorId Int? // selected Plex/Jellyfin playback library; null preserves legacy playlists
  sortMode String @default("artist_title") // artist_title | shuffle
  maxVideos Int? // null preserves existing unlimited playlists
  shuffleSeed Int?

  items PlaylistItem[]
  syncs PlaylistSync[]
}

model PlaylistItem {
  id           Int        @id @default(autoincrement())
  playlistId   Int
  playlist     Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  musicVideoId Int?
  musicVideo   MusicVideo? @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  sortOrder    Int

  @@unique([playlistId, musicVideoId])
  recordingPartId Int?
  recordingPart RecordingPart? @relation(fields: [recordingPartId], references: [id], onDelete: Restrict)
  songId Int?
  song LiveSongPerformance? @relation(fields: [songId], references: [id], onDelete: Restrict)
  fullRecordingFallback Boolean @default(false)

}

// Per-connector push state for a playlist. Push is a full replace (delete
// remote playlist, recreate) rather than a diff — matches this codebase's
// existing "manual buttons, no incremental sync" pattern for connectors
// (see LibraryConnector sync), and avoids drift between vidarr's item order
// and whatever partial add/remove state a diff could leave behind.
model PlaylistSync {
  id               Int              @id @default(autoincrement())
  playlistId       Int
  playlist         Playlist         @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  connectorId      Int
  connector        LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  remotePlaylistId String?
  lastPushedAt     DateTime?
  lastPushStatus   String? // "success" | "failed" | "partial"
  lastPushError    String?
  unmatchedCount   Int?

  @@unique([playlistId, connectorId])
}

model LibraryArtist {
  id             Int              @id @default(autoincrement())
  connectorId    Int
  connector      LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  externalId     String
  name           String
  normalizedName String
  genre          String?
  playCount      Int?
  musicbrainzArtistId String?
  musicbrainzSource String? // connector | embedded
  lastSyncedAt   DateTime         @default(now())

  @@unique([connectorId, externalId])
}

model MusicBrainzArtistCandidate {
  id             Int      @id @default(autoincrement())
  artistId       Int
  artist         Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  musicbrainzArtistId String
  name           String
  sortName       String?
  artistType     String?
  country        String?
  disambiguation String?
  score          Float
  evidence       String // JSON
  status         String @default("suggested") // suggested | rejected
  lastSeenAt     DateTime @default(now())

  @@unique([artistId, musicbrainzArtistId])
  @@index([artistId, status, score])
}

// Discovery evidence is not a catalog video. A candidate enters MusicVideo
// only after it is identified as a song music video for a confirmed artist.
model VideoReviewCandidate {
  id          Int      @id @default(autoincrement())
  source      String   // youtube | local
  externalId  String   // YouTube id or absolute local path
  artistId    Int?
  artist      Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  artistName  String
  title       String
  url         String?
  filePath    String?
  decision    String   @default("pending") // pending | approved | rejected
  reason      String?
  sourcePublishedAt DateTime? // YouTube public publication time, when available
  firstSeenAt DateTime @default(now()) // first observed by Vidarr, independent of provider dates
  lastSeenAt  DateTime? // latest successful source scan containing this item
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
  @@index([decision, artistId])
}

model RecommendationProviderConfig {
  id             Int       @id @default(autoincrement())
  provider       String    @unique // "lastfm" | "spotify" | "musicbrainz"
  enabled        Boolean   @default(false)
  apiKey         String? // Last.fm
  clientId       String? // Spotify
  clientSecret   String? // Spotify client secret / Last.fm shared secret
  accessToken    String? // Spotify (cached client-credentials token)
  tokenExpiresAt DateTime? // Spotify
}

// Independent of recommendation-provider enablement. Never expose credentials
// through status responses. Disabling/unlinking discards pending playback.
model LastFmAccount {
  id                Int       @id @default(1)
  username          String?
  sessionKey        String?
  pendingToken      String?
  pendingExpiresAt  DateTime?
  scrobblingEnabled Boolean   @default(false)
  lastPollAt        DateTime?
  lastScrobbledAt   DateTime?
  lastError         String?
}

// One observed play, including its durable submission state. A stable start
// timestamp is reused on retry; accepted/ignored submissions are never resent.
model LastFmPlayback {
  id              Int      @id @default(autoincrement())
  connectorId     Int
  libraryId       String
  sessionId       String
  externalId      String
  artist          String
  track           String
  durationSeconds Float
  startedAt       Int
  lastObservedAt  DateTime
  positionSeconds Float
  playing         Boolean
  listenedSeconds Float    @default(0)
  active          Boolean  @default(true)
  nowPlayingSent  Boolean  @default(false)
  status          String?  // null (observing), pending, sent, ignored, failed
  attempts        Int      @default(0)
  nextAttemptAt   DateTime?
  lastError       String?

  @@index([connectorId, sessionId, active])
  @@index([status, startedAt])
}

model QualifiedPlayback {
  id Int @id @default(autoincrement())
  musicVideoId Int
  musicVideo MusicVideo @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  connectorId Int
  sourceKey String
  libraryId String
  sessionId String
  externalId String
  userId String?
  durationSeconds Float
  positionSeconds Float
  playing Boolean
  listenedSeconds Float @default(0)
  qualifiedAt DateTime?
  firstObservedAt DateTime @default(now())
  lastObservedAt DateTime
  active Boolean @default(true)

  @@index([sourceKey, sessionId, active])
  @@index([active, lastObservedAt])
}

model Recommendation {
  id                   Int      @id @default(autoincrement())
  artistName           String
  normalizedArtistName String   @unique
  mbid                 String?
  aggregateScore       Float
  dismissed            Boolean  @default(false)
  dateFound            DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  addedArtistId        Int?

  sourceHits RecommendationSourceHit[]
}

model RecommendationSourceHit {
  id               Int            @id @default(autoincrement())
  recommendationId Int
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  source           String // "library" | "lastfm" | "spotify" | "musicbrainz"
  sourceRef        String?
  seedArtistName   String
  score            Float
  reason           String
}


// Live catalog identity is separate from captures and physical ownership.
// No title/date uniqueness: unknown details must never merge distinct shows.
model LivePerformance {
  removedAt DateTime?
  occasionId Int?
  occasion LiveOccasion? @relation(fields: [occasionId], references: [id], onDelete: Restrict)
  localTime String?
  timeZone String?
  privateAddress String?
  id Int @id @default(autoincrement())
  artistId Int
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)
  title String
  performanceDate String? // YYYY, YYYY-MM or YYYY-MM-DD; null is unknown
  venue String?
  city String?
  setting String @default("concert")
  style String @default("unknown")
  notes String @default("")
  identityStatus String @default("independent")
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  songs LiveSongPerformance[]
  recordings RecordingPerformance[]
  setlistFmId String? @unique
  venueExternalId String?
  country String?
  tour String?
  sourceVersion String?
  sourcePayload String?
  correctionPayload String?
  userEdited Boolean @default(true)
  referenceComplete Boolean @default(false)
  monitored Boolean @default(false)
  ignored Boolean @default(false)
  lastEvidenceAt DateTime @default(now())
  lastSearchAt DateTime?
  nextSearchAt DateTime?
  emptySearches Int @default(0)
  qualifiedPlayCount Int @default(0)
  credits LiveCredit[]
  views LiveViewing[]
  rules LiveMonitoringRule[]

  @@index([artistId, performanceDate, id])
  @@index([setting, style, id])
  @@index([monitored, ignored, lastSearchAt, id])
  @@index([identityStatus, lastEvidenceAt])
}

model LiveSongPerformance {
  id Int @id @default(autoincrement())
  performanceId Int
  performance LivePerformance @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  position Int
  title String
  section String?
  kind String @default("unknown") // full | snippet | medleyComponent | unknown; not coverage proof
  musicbrainzWorkId String?
  style String @default("unknown")
  durationSeconds Float?
  qualifiedPlayCount Int @default(0)
  coverage RecordingCoverage[]
  views LiveSongViewing[]
  playlistItems PlaylistItem[]
  credits LiveCredit[]

  @@unique([performanceId, position])
}

// Shared capture/edit identity, suitable for either catalog. This first increment
// records candidates only; a URL/coverage claim never creates file ownership.
model Recording {
  catalogType String @default("live")
  legacySources AcquisitionSource[]
  legacyServerObservations LibraryVideo[]
  id Int @id @default(autoincrement())
  musicVideoId Int?
  musicVideo MusicVideo? @relation(fields: [musicVideoId], references: [id], onDelete: SetNull)
  title String
  claimedCoverage String @default("unknown")
  origin String @default("unknown") // professional | audience | unknown
  evidenceUrl String?
  notes String @default("")
  reviewStatus String @default("pending")
  identityVerified Boolean @default(false)
  videoVerified Boolean @default(false)
  pinned Boolean @default(false)
  preferred Boolean @default(false)
  verifiedCoverage Int?
  audioScore Float?
  visualScore Float?
  resolution Int?
  qualityVerified Boolean @default(false)
  uninterruptedVerified Boolean @default(false)
  evidence String @default("{}")
  deletionState String?
  deletionError String?
  deletionNextAttemptAt DateTime?
  deletionTargets String?
  deletionAttempts Int @default(0)
  parts RecordingPart[]
  sources RecordingSource[]
  queueItems DownloadQueueItem[]
  history History[]
  createdAt DateTime @default(now())
  performances RecordingPerformance[]

  @@index([musicVideoId])
  @@index([reviewStatus, id])
}

model RecordingPerformance {
  preferred Boolean @default(false)
  identityVerified Boolean @default(false)
  recordingId Int
  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  performanceId Int
  performance LivePerformance @relation(fields: [performanceId], references: [id], onDelete: Restrict)

  @@id([recordingId, performanceId])
  @@index([performanceId])
}


model LiveConfiguration {
  id Int @id @default(1)
  setlistApiKey String?
  policy String @default("{}")
  setlistPaused Boolean @default(false)
  providerRetryAt DateTime?
}

model LiveCredit {
  id Int @id @default(autoincrement())
  artistId Int
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)
  performanceId Int
  performance LivePerformance @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  songId Int?
  song LiveSongPerformance? @relation(fields: [songId], references: [id], onDelete: Restrict)
  role String
  @@index([performanceId, songId])
}

model RecordingSource {
  queueItems DownloadQueueItem[]
  id Int @id @default(autoincrement())
  recordingId Int
  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  provider String
  externalId String?
  url String
  payload String @default("{}")
  accepted Boolean @default(false)
  available Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@unique([provider, externalId])
  @@unique([recordingId, url])
}

model RecordingPart {
  id Int @id @default(autoincrement())
  recordingId Int
  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  position Int
  rootFolderId Int?
  rootFolder RootFolder? @relation(fields: [rootFolderId], references: [id], onDelete: Restrict)
  path String? @unique
  sizeBytes BigInt?
  sha256 String?
  storageIdentity String?
  durationSeconds Float?
  available Boolean @default(true)
  importedQueueId Int?
  legacyMusicVideoFileId Int? @unique
  legacyMusicVideoFile MusicVideoFile? @relation(fields: [legacyMusicVideoFileId], references: [id], onDelete: SetNull)
  registeredAt DateTime @default(now())
  coverage RecordingCoverage[]
  serverCopies RecordingServerCopy[]
  playlistItems PlaylistItem[]
  @@unique([recordingId, position])
  @@unique([importedQueueId, position])
  @@index([sha256])
  @@index([rootFolderId, available, id])
}

model RecordingCoverage {
  id Int @id @default(autoincrement())
  partId Int
  part RecordingPart @relation(fields: [partId], references: [id], onDelete: Restrict)
  songId Int
  song LiveSongPerformance @relation(fields: [songId], references: [id], onDelete: Restrict)
  startSeconds Float?
  endSeconds Float?
  verified Boolean @default(false)
  fullSong Boolean @default(false)
  @@unique([partId, songId])
}

model RecordingServerCopy {
  id Int @id @default(autoincrement())
  partId Int
  part RecordingPart @relation(fields: [partId], references: [id], onDelete: Restrict)
  connectorId Int
  connector LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  libraryId String
  externalId String
  expectedPath String
  available Boolean @default(true)
  playCount Int?
  confirmedAt DateTime @default(now())
  @@unique([connectorId, libraryId, externalId])
  @@unique([partId, connectorId])
}

model LiveMonitoringRule {
  id Int @id @default(autoincrement())
  artistId Int
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)
  performanceId Int?
  performance LivePerformance? @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  tour String?
  filters String @default("{}")
  dailyBudget Int @default(50)
  state String @default("active")
  cursor Int @default(1)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  @@index([state, lastRunAt])
  @@index([artistId, state, id])
}

model LiveRequestBudget {
  key String @id
  used Int @default(0)
}

model LiveSearchJournal {
  key String @id
  provider String
  lastSearchAt DateTime?
  retryAt DateTime?
  failures Int @default(0)
  emptyCount Int @default(0)
  outcome String?
  payload String?
  expiresAt DateTime
  @@index([expiresAt])
}

model LiveViewing {
  id Int @id @default(autoincrement())
  serverKey String
  userId String
  performanceId Int
  performance LivePerformance @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  watchedSeconds Float @default(0)
  durationSeconds Float?
  lastCreditAt DateTime?
  qualifiedAt DateTime?
  completedAt DateTime?
  active Boolean @default(true)
  positionSeconds Float @default(0)
  partId Int?
  updatedAt DateTime @updatedAt
  observations LivePlaybackObservation[]
  songs LiveSongViewing[]
  @@index([serverKey, userId, performanceId, active])
}

model LivePlaybackObservation {
  key String @id
  viewingId Int
  viewing LiveViewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)
  positionSeconds Float
  playing Boolean
  partId Int
  lastObservedAt DateTime
}

model LiveSongViewing {
  id Int @id @default(autoincrement())
  viewingId Int
  viewing LiveViewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)
  songId Int
  song LiveSongPerformance @relation(fields: [songId], references: [id], onDelete: Restrict)
  watchedSeconds Float @default(0)
  durationSeconds Float?
  qualifiedAt DateTime?
  @@unique([viewingId, songId])
}

model LiveExclusion {
  id Int @id @default(autoincrement())
  artistId Int
  scope String
  fingerprint String @unique
  createdAt DateTime @default(now())
}

model LiveOccasion {
  id Int @id @default(autoincrement())
  title String
  occasionDate String?
  performances LivePerformance[]
}
