generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/macOS/whatever host runs `npm run dev`).
    // "debian-openssl-3.0.x" is explicit so a client generated on a developer
    // machine also contains the engine required by the Debian Docker runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artist {
  id               Int          @id @default(autoincrement())
  name             String
  sortName         String
  imvdbArtistId    String?      @unique
  musicbrainzArtistId String?   @unique
  musicbrainzMatchStatus String @default("unmatched") // unmatched | suggested | ambiguous | confirmed | notFound | failed
  musicbrainzMatchConfidence Float?
  musicbrainzMatchEvidence String? // JSON describing the observations used for the match
  musicbrainzRefreshedAt DateTime?
  artistType       String?
  country          String?
  disambiguation   String?
  // Defaults to false: a newly discovered/imported artist shouldn't start
  // auto-downloading its whole catalog just from being added. Only the
  // DEFAULT changed here — existing rows keep whatever value they already
  // had (see migration 20260920041539_artist_unmonitored_by_default).
  monitored        Boolean      @default(false)
  rootFolderId     Int
  rootFolder       RootFolder   @relation(fields: [rootFolderId], references: [id])
  qualityProfileId Int
  qualityProfile   QualityProfile @relation(fields: [qualityProfileId], references: [id])
  posterUrl        String?
  genre            String? // user-editable; auto-fillable from a matched LibraryArtist (Jellyfin) or a "standard" external source (Spotify's controlled-vocabulary genres) — see pipeline/genreMatch.ts
  genreSource      String? // user | embedded | musicbrainz | connector | folksonomy
  metadataRefreshedAt DateTime?
  reconciledAt     DateTime?
  addedAt          DateTime     @default(now())

  musicVideos   MusicVideo[]
  youtubeSources YoutubeSource[]
  sources       ArtistSource[]
  musicbrainzCandidates MusicBrainzArtistCandidate[]
}

model MusicVideo {
  id             Int      @id @default(autoincrement())
  artistId       Int
  artist         Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title          String
  normalizedTitle String
  imvdbVideoId   String?  @unique
  musicbrainzRecordingId String? @unique
  musicbrainzAudioRecordingId String?
  catalogKind    String   @default("official") // official | supplementary | inventory
  youtubeVideoId String?  @unique
  releaseYear    Int?
  director       String?
  durationSeconds Int?
  genre          String? // user-editable "song tag" — see Artist.genre
  monitored      Boolean  @default(true)
  // Independent of `monitored`: an explicit "don't act on this one" that
  // always blocks acquisition (even a deliberate manual grab), whereas
  // `monitored` only gates automatic backlog/upgrade search — see
  // pipeline/videoStatus.ts.
  ignored        Boolean  @default(false)
  hasFile        Boolean  @default(false)
  thumbnailUrl   String?
  catalogStatus  String   @default("active") // "active" | "removedReview"
  lastSeenAt     DateTime?
  removedAt      DateTime?
  awaitingServerScanAt DateTime?
  addedAt        DateTime @default(now())

  file           MusicVideoFile?
  queueItems     DownloadQueueItem[]
  history        History[]
  playlistItems  PlaylistItem[]
  libraryVideos  LibraryVideo[] @relation("LibraryVideoMatch")
  rejectedByLibraryVideos LibraryVideo[] @relation("LibraryVideoRejectedMatch")
  acquisitionSources AcquisitionSource[]

  @@unique([artistId, normalizedTitle])
}

model ArtistSource {
  id          Int      @id @default(autoincrement())
  artistId    Int
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String?
  origin      String
  lastSeenAt  DateTime @default(now())

  @@unique([artistId, provider, origin])
}

model AcquisitionSource {
  id             Int        @id @default(autoincrement())
  musicVideoId   Int
  musicVideo     MusicVideo @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  provider       String
  externalId     String?
  url            String
  authority      String // "authoritative" | "verified" | "heuristic" | "manual"
  confidence     String // "confirmed" | "probable" | "review"
  discoveryOrigin String
  accepted       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([musicVideoId, provider, url])
  @@index([musicVideoId, authority, confidence])
}

model MusicVideoFile {
  id           Int        @id @default(autoincrement())
  musicVideoId Int        @unique
  musicVideo   MusicVideo @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  path         String
  qualityId    Int?
  quality      Quality?   @relation(fields: [qualityId], references: [id])
  sizeBytes    BigInt
  mediaInfo    String? // JSON blob: codec/resolution/bitrate
  originalFilename String
  dateAdded    DateTime   @default(now())
  playCount        Int?      // synced from a Plex/Jellyfin library connector's watch stats for the matched item — see pipeline/playCountSync.ts
  playCountSyncedAt DateTime?
}

model Quality {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  source     String // "web" | "youtube" | "unknown"
  resolution Int?
  weight     Int

  profileItems   QualityProfileItem[]
  files          MusicVideoFile[]
}

model QualityProfile {
  id              Int    @id @default(autoincrement())
  name            String @unique
  cutoffQualityId Int

  items   QualityProfileItem[]
  artists Artist[]
}

model QualityProfileItem {
  id               Int            @id @default(autoincrement())
  qualityProfileId Int
  qualityProfile   QualityProfile @relation(fields: [qualityProfileId], references: [id], onDelete: Cascade)
  qualityId        Int
  quality          Quality        @relation(fields: [qualityId], references: [id])
  allowed          Boolean        @default(true)

  @@unique([qualityProfileId, qualityId])
}

model RootFolder {
  id             Int      @id @default(autoincrement())
  path           String   @unique
  freeSpaceBytes BigInt?
  accessible     Boolean  @default(true)
  lastCheckedAt  DateTime?
  targetConnectorId Int?
  targetConnector LibraryConnector? @relation(fields: [targetConnectorId], references: [id], onDelete: SetNull)

  artists Artist[]
}

model Indexer {
  id             Int     @id @default(autoincrement())
  name           String
  implementation String // "Torznab" | "Newznab"
  baseUrl        String
  apiKey         String?
  categories     String // JSON-encoded int[]
  enabled        Boolean @default(true)
  priority       Int     @default(25)
}

model DownloadClient {
  id             Int     @id @default(autoincrement())
  name           String
  implementation String // "qBittorrent" | "SABnzbd"
  host           String
  port           Int
  username       String?
  password       String?
  apiKey         String?
  category       String?
  enabled        Boolean @default(true)
  priority       Int     @default(25)

  queueItems DownloadQueueItem[]
}

model YoutubeSource {
  id             Int       @id @default(autoincrement())
  type           String // "channel" | "playlist" | "single_video"
  url            String
  artistId       Int
  artist         Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  monitored      Boolean   @default(true)
  lastPolledAt   DateTime?
  qualitySelector String   @default("bestvideo[height<=1080]+bestaudio")
}

model DownloadQueueItem {
  id               Int             @id @default(autoincrement())
  musicVideoId     Int
  musicVideo       MusicVideo      @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  sourceType       String // "indexer" | "youtube"
  sourceRef        String
  downloadClientId Int?
  downloadClient   DownloadClient? @relation(fields: [downloadClientId], references: [id])
  status           String // "queued" | "downloading" | "submissionUnknown" | "importing" | "failed"
  progress         Float           @default(0)
  quality          String? // parsed at grab time; needed at import time since no file exists yet to read it from
  addedAt          DateTime        @default(now())
}

model History {
  id           Int        @id @default(autoincrement())
  musicVideoId Int
  musicVideo   MusicVideo @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  eventType    String // "grabbed" | "downloadFolderImported" | "downloadFailed" | "deleted" | "renamed"
  date         DateTime   @default(now())
  data         String? // JSON blob
}

model ActivityLog {
  id      Int      @id @default(autoincrement())
  level   String // "info" | "warn" | "error"
  source  String
  message String
  date    DateTime @default(now())
}

model ScheduledTask {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  intervalMs   Int
  lastRunAt    DateTime?
  lastResult   String? // "success" | "failed"
  lastError    String?
}

model Settings {
  id             Int     @id @default(1)
  namingFormat   String  @default("{Artist Name}/{Artist Name} - {Video Title} ({Year}) [{Quality}]")
  transferMode   String  @default("hardlink") // "hardlink" | "copy" | "move"
  minFreeSpaceMb Int     @default(1024)
  imvdbApiKey    String?
  apiKey         String? // vidarr's own API key — required on every /api/v1/* request except /health. Generated on first boot (see pipeline/auth.ts); matches Sonarr/Radarr's own single-user API-key model.
  apiKeyGeneratedAt DateTime? // when the current apiKey was generated — bounds the /setup/bootstrap-key reveal window (see api/setup.ts)
  apiKeyFirstUsedAt DateTime? // set the first time apiKey successfully authenticates a request; once set, /setup/bootstrap-key permanently stops revealing it

  // Google Sign-On: an alternative, browser-only way to obtain the real
  // apiKey (see api/googleAuth.ts) — not a parallel auth system. Every
  // /api/v1/* request still authenticates with apiKey exactly as before;
  // this just gates *handing that key to a browser* behind "is this the one
  // allowed Google account" instead of "did you already have the key."
  googleClientId     String?
  googleClientSecret String?
  googleAllowedEmail String? // the single Google account allowed to sign in this way

  // Username/password login: another alternative, browser-only way to obtain
  // the real apiKey (see api/localAuth.ts and pipeline/password.ts) — same
  // relationship to apiKey as Google Sign-On above, not a parallel credential.
  // adminPasswordHash is never the plaintext password — only set via
  // POST /api/v1/auth/login/credentials, which hashes it server-side.
  adminUsername     String?
  adminPasswordHash String? // format "<hex salt>:<hex scrypt derived key>"
}

model LibraryConnector {
  id             Int       @id @default(autoincrement())
  name           String
  type           String // "plex" | "jellyfin" | "subsonic"
  host           String
  authToken      String? // Plex X-Plex-Token, or Jellyfin API key
  username       String? // Jellyfin / Subsonic
  password       String? // Subsonic only (salted-MD5 auth requires it server-side)
  userId         String? // Jellyfin user id resolved by Test; separate from the selected music library
  musicLibraryId String? // selected Plex/Jellyfin music section used to read artists (LibraryArtist sync)
  musicPath      String? // optional local/container path scanned read-only for embedded Picard tags
  videoLibraryId String? // section/library holding vidarr's own downloaded music videos — used for playlist push; a different library than musicLibraryId, picked by the user from listSections()
  enabled        Boolean   @default(true)
  lastSyncedAt   DateTime?
  lastSyncStatus String? // "success" | "failed"
  lastSyncError  String?
  syncRunning    Boolean    @default(false)
  syncProcessed  Int        @default(0)
  syncTotal      Int?

  libraryArtists    LibraryArtist[]
  libraryRecordings LibraryRecording[]
  libraryVideos     LibraryVideo[]
  playlistSyncs  PlaylistSync[]
  rootFolders    RootFolder[]
}

model LibraryRecording {
  id                        Int              @id @default(autoincrement())
  connectorId               Int
  connector                 LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  filePath                  String
  title                     String
  album                     String?
  artistName                String
  albumArtistName           String?
  genre                     String?
  trackNumber               Int?
  discNumber                Int?
  musicbrainzArtistId       String?
  musicbrainzAlbumArtistId  String?
  musicbrainzRecordingId    String?
  musicbrainzReleaseId      String?
  musicbrainzReleaseGroupId String?
  lastSyncedAt              DateTime         @default(now())

  @@unique([connectorId, filePath])
  @@index([musicbrainzArtistId])
  @@index([musicbrainzRecordingId])
}

// A video observed in a selected Plex/Jellyfin music-video library. This is
// deliberately separate from MusicVideoFile: availability in a media server
// does not prove Vidarr owns or can access the underlying local file.
model LibraryVideo {
  id                   Int              @id @default(autoincrement())
  connectorId          Int
  connector            LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  externalId           String
  title                String
  normalizedTitle      String
  artistName           String
  normalizedArtistName String
  releaseYear          Int?
  durationSeconds      Int?
  path                 String?
  playCount            Int?
  hasThumbnail         Boolean          @default(false)
  available            Boolean          @default(true)
  lastSyncedAt         DateTime         @default(now())
  musicVideoId         Int?
  musicVideo           MusicVideo?      @relation("LibraryVideoMatch", fields: [musicVideoId], references: [id], onDelete: SetNull)
  // Set (alongside matchConfidence) only for a fuzzy, non-exact match a sync
  // proposed — null for an exact-key match, which needs no review. See
  // pipeline/reconciliation.ts.
  matchConfidence      String?
  // A human-rejected candidate for this row, remembered so the next sync's
  // fuzzy fallback doesn't immediately re-propose the same wrong match —
  // confirmed via research that nothing previously remembered a past
  // reconciliation decision at all.
  rejectedMusicVideoId Int?
  rejectedMusicVideo   MusicVideo?      @relation("LibraryVideoRejectedMatch", fields: [rejectedMusicVideoId], references: [id], onDelete: SetNull)

  @@unique([connectorId, externalId])
  @@index([normalizedArtistName, normalizedTitle])
}

model Playlist {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  kind      String   @default("static") // static | smart
  ruleFilters String? // validated PlaylistFilters JSON for smart playlists
  ruleMatchMode String? // all | any
  regenerateIntervalMinutes Int? // null = manual only
  lastGeneratedAt DateTime?

  items PlaylistItem[]
  syncs PlaylistSync[]
}

model PlaylistItem {
  id           Int        @id @default(autoincrement())
  playlistId   Int
  playlist     Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  musicVideoId Int
  musicVideo   MusicVideo @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  sortOrder    Int

  @@unique([playlistId, musicVideoId])
}

// Per-connector push state for a playlist. Push is a full replace (delete
// remote playlist, recreate) rather than a diff — matches this codebase's
// existing "manual buttons, no incremental sync" pattern for connectors
// (see LibraryConnector sync), and avoids drift between vidarr's item order
// and whatever partial add/remove state a diff could leave behind.
model PlaylistSync {
  id               Int              @id @default(autoincrement())
  playlistId       Int
  playlist         Playlist         @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  connectorId      Int
  connector        LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  remotePlaylistId String?
  lastPushedAt     DateTime?
  lastPushStatus   String? // "success" | "failed" | "partial"
  lastPushError    String?
  unmatchedCount   Int?

  @@unique([playlistId, connectorId])
}

model LibraryArtist {
  id             Int              @id @default(autoincrement())
  connectorId    Int
  connector      LibraryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  externalId     String
  name           String
  normalizedName String
  genre          String?
  playCount      Int?
  musicbrainzArtistId String?
  musicbrainzSource String? // connector | embedded
  lastSyncedAt   DateTime         @default(now())

  @@unique([connectorId, externalId])
}

model MusicBrainzArtistCandidate {
  id             Int      @id @default(autoincrement())
  artistId       Int
  artist         Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  musicbrainzArtistId String
  name           String
  sortName       String?
  artistType     String?
  country        String?
  disambiguation String?
  score          Float
  evidence       String // JSON
  status         String @default("suggested") // suggested | rejected
  lastSeenAt     DateTime @default(now())

  @@unique([artistId, musicbrainzArtistId])
  @@index([artistId, status, score])
}

model RecommendationProviderConfig {
  id             Int       @id @default(autoincrement())
  provider       String    @unique // "lastfm" | "spotify" | "musicbrainz"
  enabled        Boolean   @default(false)
  apiKey         String? // Last.fm
  clientId       String? // Spotify
  clientSecret   String? // Spotify
  accessToken    String? // Spotify (cached client-credentials token)
  tokenExpiresAt DateTime? // Spotify
}

model Recommendation {
  id                   Int      @id @default(autoincrement())
  artistName           String
  normalizedArtistName String   @unique
  mbid                 String?
  aggregateScore       Float
  dismissed            Boolean  @default(false)
  dateFound            DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  addedArtistId        Int?

  sourceHits RecommendationSourceHit[]
}

model RecommendationSourceHit {
  id               Int            @id @default(autoincrement())
  recommendationId Int
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  source           String // "library" | "lastfm" | "spotify" | "musicbrainz"
  sourceRef        String?
  seedArtistName   String
  score            Float
  reason           String
}
