FROM node:24-bookworm-slim AS build
WORKDIR /source
COPY package.json package-lock.json .npmrc ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
ENV NODE_OPTIONS=--max-old-space-size=3072
# Complete the upstream type check before bundling, releasing its heap between stages.
RUN npm run build:check
COPY <<'EOF' /source/vidarr.webpack.cjs
const config = require('./webpack.prod.js');
const MinimizerPlugin = require('minimizer-webpack-plugin');
config.parallelism = 2;
config.plugins = config.plugins.filter(plugin => plugin.constructor.name !== 'ForkTsCheckerWebpackPlugin');
config.optimization.minimizer = [new MinimizerPlugin({ parallel: false })];
module.exports = config;
EOF
RUN NODE_ENV=production npx webpack --config vidarr.webpack.cjs --progress

FROM scratch AS artifact
COPY --from=build /source/dist/ /source/dist/
